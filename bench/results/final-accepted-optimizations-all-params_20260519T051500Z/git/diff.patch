+static int build_project_relative_path(char *buffer, size_t size, const char *relative_suffix)
+{
+    char exe_path[MAX_RUNTIME_PATH];
+    char *cursor = NULL;
+    ssize_t length = readlink("/proc/self/exe", exe_path, sizeof(exe_path) - 1);
+
