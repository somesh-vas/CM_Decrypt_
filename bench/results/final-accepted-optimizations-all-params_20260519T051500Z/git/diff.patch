+diff --git a/GPU_Optimised/param/param348864/src/cuda/Decrypt.cu b/GPU_Optimised/param/param348864/src/cuda/Decrypt.cu
+index c5debf5..fca44dd 100644
+--- a/GPU_Optimised/param/param348864/src/cuda/Decrypt.cu
++++ b/GPU_Optimised/param/param348864/src/cuda/Decrypt.cu
+@@ -25,28 +25,32 @@ __global__ void SyndromeKernel(
+     gf        * __restrict__ d_syndromes)
+ {
+     // ---- Shared memory (static) ----
+-    __shared__ gf c[sb];              // unpacked bits   (sb ≤ 24576)
++    __shared__ uint32_t c_words[(sb + 31) / 32];
+     __shared__ gf s_out[2 * SYS_T];   // 2·t accumulators
+ 
+     const int tid    = threadIdx.x;
+     const int ct     = blockIdx.x;               // one block per CT
+-    const int vecCnt = SYND_BYTES >> 2;          // SYND_BYTES/4
++    const int c_word_count = (sb + 31) / 32;
+ 
+-    // 1) unpack ciphertext into bit array
+-    for (int v = tid; v < vecCnt; v += blockDim.x) {
+-        uchar4 chunk = reinterpret_cast<const uchar4*>(
+-                          d_ciphertexts + ct * SYND_BYTES)[v];
+-        unsigned r0 = chunk.x, r1 = chunk.y,
+-                 r2 = chunk.z, r3 = chunk.w;
++    // 1) load packed ciphertext words into shared memory.
++    for (int word = tid; word < c_word_count; word += blockDim.x) {
++        uint32_t packed = 0;
++        const int byte_base = word << 2;
+ 
+         #pragma unroll
+-        for (int b = 0; b < 8; ++b) {
+-            int baseBit = (v << 5) + b;  // v*32 + b
