+--- a/GPU_Optimised/param/param8192128/src/cuda/Decrypt.cu
++++ b/GPU_Optimised/param/param8192128/src/cuda/Decrypt.cu
+@@ -18,28 +18,32 @@ __global__ void SyndromeKernel(
+     gf        * __restrict__ d_syndromes)
+ {
+     // ---- Shared memory (static) ----
+-    __shared__ gf c[sb];              // unpacked bits   (sb ≤ 24576)
++    __shared__ uint32_t c_words[(sb + 31) / 32];
+     __shared__ gf s_out[2 * SYS_T];   // 2·t accumulators
+ 
+     const int tid    = threadIdx.x;
+     const int ct     = blockIdx.x;               // one block per CT
+-    const int vecCnt = SYND_BYTES >> 2;          // SYND_BYTES/4
++    const int c_word_count = (sb + 31) / 32;
+ 
+-    // 1) unpack ciphertext into bit array
+-    for (int v = tid; v < vecCnt; v += blockDim.x) {
+-        uchar4 chunk = reinterpret_cast<const uchar4*>(
+-                          d_ciphertexts + ct * SYND_BYTES)[v];
+-        unsigned r0 = chunk.x, r1 = chunk.y,
+-                 r2 = chunk.z, r3 = chunk.w;
++    // 1) load packed ciphertext words into shared memory.
++    for (int word = tid; word < c_word_count; word += blockDim.x) {
++        uint32_t packed = 0;
++        const int byte_base = word << 2;
+ 
+         #pragma unroll
+-        for (int b = 0; b < 8; ++b) {
+-            int baseBit = (v << 5) + b;  // v*32 + b
+-            if (baseBit < sb)       c[baseBit]       = (r0 >> b) & 1u;
+-            if (baseBit+8  < sb)    c[baseBit + 8]   = (r1 >> b) & 1u;
+-            if (baseBit+16 < sb)    c[baseBit + 16]  = (r2 >> b) & 1u;
+-            if (baseBit+24 < sb)    c[baseBit + 24]  = (r3 >> b) & 1u;
++        for (int k = 0; k < 4; ++k) {
++            const int byte_idx = byte_base + k;
++            if (byte_idx < SYND_BYTES) {
++                packed |= ((uint32_t)d_ciphertexts[ct * SYND_BYTES + byte_idx]) << (8 * k);
++            }
++        }
++
++        const int remaining_bits = sb - (word << 5);
++        if (remaining_bits > 0 && remaining_bits < 32) {
++            packed &= ((1u << remaining_bits) - 1u);
+         }
++
++        c_words[word] = packed;
+     }
+     __syncthreads();
+ 
+@@ -51,7 +55,9 @@ __global__ void SyndromeKernel(
+         gf acc = 0;
+         #pragma unroll 8
+         for (int bit = 0; bit < sb; ++bit) {
+-            gf mask = -(gf)(c[bit] & 1u);   // 0 or 0xFFFF
++            const uint32_t packed = c_words[bit >> 5];
++            const gf cbit = (gf)((packed >> (bit & 31)) & 1u);
++            gf mask = -(gf)cbit;   // 0 or 0xFFFF
+             acc ^= (col[0] & mask);
+             col += stride;
+         }
